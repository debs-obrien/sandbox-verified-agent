# --- AI Gateway (model calls on the Next.js host) ---
# Preferred for local scripts / non-Vercel hosts:
AI_GATEWAY_API_KEY=

# Optional model override (must be a live /v1/models id):
AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5

# --- Vercel Sandbox auth ---
# Preferred locally: link the project, then pull OIDC (~12h lifetime)
#   npx vercel link
#   npx vercel env pull .env.local
# VERCEL_OIDC_TOKEN=

# Or, for external/CI without OIDC (passed explicitly to Sandbox.create):
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# On Vercel deployments, OIDC is automatic for both Sandbox and AI Gateway.

# --- Protect /api/run (recommended on any public deploy) ---
# Require this header on POST /api/run: x-run-secret: <value>
# RUN_SECRET=
# Or, behind Vercel Deployment Protection only:
# ALLOW_PUBLIC_RUNS=true
# Optional limits (per server instance):
# RUN_MAX_CONCURRENT=1
# RUN_MAX_PER_HOUR=6
