# --- AI Gateway (model calls on the Next.js host) ---
# Preferred for local scripts / non-Vercel hosts:
AI_GATEWAY_API_KEY=

# Optional model override (must be a live /v1/models id):
AI_GATEWAY_MODEL=anthropic/claude-haiku-4.5

# --- Vercel Sandbox + Gateway OIDC ---
# On Vercel Functions the OIDC token arrives as the `x-vercel-oidc-token`
# request header. Use getVercelOidcToken() from @vercel/oidc (Sandbox + AI
# Gateway SDKs already call this). Locally after linking:
#   npx vercel link
#   npx vercel env pull .env.local
# VERCEL_OIDC_TOKEN=

# Or, for external/CI without OIDC (passed explicitly to Sandbox.create):
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=

# --- Vercel Blob (required on deploy so /receipt/[id] works across instances) ---
# Connect a Blob store to the project in the Vercel dashboard, then:
# BLOB_READ_WRITE_TOKEN=
# Locally, receipts fall back to ./data/receipts when this is unset.

# --- Protect /api/run (recommended on any public deploy) ---
# Require this header on POST /api/run: x-run-secret: <value>
# RUN_SECRET=
# Or, behind Vercel Deployment Protection only:
# ALLOW_PUBLIC_RUNS=true
# Optional limits (per server instance):
# RUN_MAX_CONCURRENT=1
# RUN_MAX_PER_HOUR=6
